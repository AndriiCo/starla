[Unit]
Description=Starla RIPE Atlas Software Probe
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/starla --config /etc/starla/config.toml
Restart=on-failure
RestartSec=10

# Scheduler bursts past the 1024 default under load.
LimitNOFILE=4096

DynamicUser=true
ConfigurationDirectory=starla
# 0755, not 0750: systemd never re-owns a configuration directory, so it
# stays root:root and a 0750 one is closed to the DynamicUser -- which then
# could not read config.toml. The file holds no secret (the key lives in the
# state directory or arrives as a credential).
ConfigurationDirectoryMode=0755
StateDirectory=starla
StateDirectoryMode=0750
RuntimeDirectory=starla
RuntimeDirectoryMode=0750
# Files Starla creates (probe_id, paused_until, the status socket) are its
# own alone. The directory modes above are set by systemd, not the umask.
# Nothing outside the service reads them: the tray connects to the socket in
# its own user's $XDG_RUNTIME_DIR, which is this service's only when both run
# as the same user, and root reads the state directory regardless.
UMask=0077

AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# /dev holds only the pseudo-devices (null, zero, urandom, ...); Starla opens
# no device node. Raw sockets for ping and traceroute need no device.
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectControlGroups=true
# Other users' processes are hidden from /proc. Not ProcSubset=pid: host
# telemetry reads /proc/uptime, /proc/buddyinfo, /proc/net and /proc/sys.
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
NoNewPrivileges=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# One list per line: systemd honours "~" only as the first character of a
# line, so "~@privileged" in the middle of the allow list was ignored (with a
# warning) and "@raw-io" joined the allow list. Raw sockets need neither
# @raw-io (that is ioperm/iopl) nor anything in @privileged; Starla never
# calls capset.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# A filtered system call fails with EPERM rather than killing the process,
# so a library probing for one it may not use (and falling back) keeps
# working, and a real need shows up as an error in the log, not a SIGSYS.
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
